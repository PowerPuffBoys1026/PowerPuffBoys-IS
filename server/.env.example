# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# Use a long random string in any non-demo environment.
JWT_SECRET=dev-secret-change-me

JWT_EXPIRES_IN=7d

# Optional. Defaults to server/data/classmate.db
# DB_FILE=./data/classmate.db

# Absence percentage at which a subject is flagged as a warning.
ATTENDANCE_THRESHOLD=20
