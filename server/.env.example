# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# Use a long random string in any non-demo environment.
JWT_SECRET=dev-secret-change-me

JWT_EXPIRES_IN=7d

# PostgreSQL connection string. Create the database and tables with:
#   npm run db:init
DATABASE_URL=postgres://postgres:postgres@localhost:5432/classmate

# Optional. Defaults to the "public" schema.
# PG_SCHEMA=public

# Set to true when your PostgreSQL provider requires SSL.
# DATABASE_SSL=false

# Absence percentage at which a subject is flagged as a warning.
ATTENDANCE_THRESHOLD=20
