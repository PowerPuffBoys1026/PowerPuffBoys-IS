# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# Required. Generate a long random value, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

JWT_EXPIRES_IN=7d

# IANA time zone used for "today" in the dashboard and overdue checks.
APP_TIMEZONE=Asia/Manila

# Comma-separated browser origins allowed by CORS. Native mobile apps are not
# affected by CORS, but Flutter Web opened from a phone needs its LAN origin,
# e.g. http://192.168.1.10:8080. Run `npm run mobile:config` to print the values.
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# PostgreSQL connection. Use a local .env for the password; never commit it.
PGHOST=localhost
PGPORT=5432
PGDATABASE=classmate
PGMAINTENANCE_DB=postgres
PGUSER=postgres
PGPASSWORD=change-me

# Absence percentage at which a subject is flagged as a warning.
ATTENDANCE_THRESHOLD=20

# Mobile-friendly request/auth limits. Phones on one Wi-Fi share an IP, so
# raise AUTH_RATE_LIMIT_MAX if several devices log in during a demo.
REQUEST_TIMEOUT_MS=30000
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
